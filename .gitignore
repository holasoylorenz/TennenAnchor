__pycache__/
*.py[cod]
*$py.class

# Pytest & test cache
.pytest_cache/
.coverage
htmlcov/

# Local outputs & binary screen captures
outputs/screenshots/
outputs/recordings/
*.raw
*.log
*.net
*.db
*.op.raw
