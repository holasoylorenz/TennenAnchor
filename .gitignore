# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Pytest & test cache
.pytest_cache/
.coverage
htmlcov/

# Local outputs & binary screen captures
outputs/screenshots/
outputs/*.raw
outputs/*.log
!outputs/.gitkeep
!outputs/amplifier.asc

# Privacy & document protection (never commit user documents or screenshots)
*.png
*.jpg
*.jpeg
*.webp
*.bmp
*.gif
*.docx
*.doc
*.xlsx
*.xls
*.pptx
*.pdf
*.csv
scratch/

# Secrets & local environment
.env*
*.key
*.pem
*.token
*id_rsa*

# Environments & packages
.venv/
env/
venv/
ENV/
build/
dist/
*.egg-info/

# IDEs & editors
.vscode/
.idea/
*.swp
*.swo

# Temporary & system files
*.tmp
Thumbs.db
Desktop.ini
